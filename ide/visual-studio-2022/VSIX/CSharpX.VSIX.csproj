<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IsVsixProject>true</IsVsixProject>
    <DeployExtension>false</DeployExtension>
    <RootNamespace>CSharpX.VisualStudio</RootNamespace>
    <AssemblyName>CSharpX.VisualStudio</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CSharpXProjectSystemDir>$(DevEnvDir)CommonExtensions\Microsoft\Project\</CSharpXProjectSystemDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.0.5165" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.0.5232" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="source.extension.vsixmanifest"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Include="CSharpX.ProjectType.pkgdef"><IncludeInVSIX>true</IncludeInVSIX></Content>
    <VSIXSourceItem Include="Templates\CSharpXConsole.zip" />
    <Content Include="semantic.py"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><IncludeInVSIX>true</IncludeInVSIX></Content>
    <Content Include="server.py"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><IncludeInVSIX>true</IncludeInVSIX></Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualStudio.ProjectSystem">
      <HintPath>$(CSharpXProjectSystemDir)Microsoft.VisualStudio.ProjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.ProjectSystem.VS">
      <HintPath>$(CSharpXProjectSystemDir)Microsoft.VisualStudio.ProjectSystem.VS.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
