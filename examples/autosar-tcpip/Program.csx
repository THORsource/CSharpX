public static void Main()
{
    // Requests consumed by the desktop TcpIp adapter.
    Console.WriteLine("ONLINE");
    Console.WriteLine("TCP vehicle-speed=42");
    Console.WriteLine("UDP heartbeat=1");
    Console.WriteLine("ONHOLD");
    Console.WriteLine("EXPECT_BLOCKED");
    Console.WriteLine("ONLINE");
    Console.WriteLine("TCP vehicle-speed=43");
    Console.WriteLine("OFFLINE");
}
